# ═══════════════════════════════════════════════════════════
# Invoice Scanner Pro — Environment Variables
# ═══════════════════════════════════════════════════════════
# Copy this file to .env and fill in your values
# On Vercel, set these as Environment Variables in the dashboard

# ─── REQUIRED: Neon PostgreSQL Database ─────────────────
# Get this from: https://console.neon.tech → Your Project → Connection Details
# Format: postgresql://user:password@host/database?sslmode=require
DATABASE_URL=postgresql://username:password@ep-cool-name-123456.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# ─── OPTIONAL: OCR.Space API Key ────────────────────────
# Get a FREE key (25,000 calls/month) from: https://ocr.space/ocrspace/free
# Without this key, the app works in DEMO MODE (generates realistic sample data)
OCR_SPACE_API_KEY=helloworld

# ─── REQUIRED: Clerk Authentication ─────────────────────
# Get from: https://dashboard.clerk.com → Your App → API Keys
# CLERK_PUBLISHABLE_KEY — Used in frontend (starts with pk_test_ or pk_live_)
CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# CLERK_SECRET_KEY — Used in backend (starts with sk_test_ or sk_live_)
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
